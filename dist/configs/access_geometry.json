{
  "config_format_version": "2.0",
  "application_name": "Test Memory R",
  "metadata": {
    "name": "Access spacing and grouping comparison",
    "author": "TMR",
    "version": "1.0",
    "description": "Compare SimpleTest and Mem-Sequence visit geometry on one allocation; includes experimental groups of 16 lines. No hardware channel targeting.",
    "tested_with_version": "0.1.1"
  },
  "system": {
    "memory_strategy": {
      "allocation_mode": "percentage_reserve",
      "reserve_percent": 20.0,
      "default_extent": {
        "mode": "full_allocation"
      },
      "default_chunk": {
        "mode": "absolute",
        "size": "256MiB"
      }
    },
    "cpu_config": {
      "type": "cores",
      "usage_percent": 100
    },
    "error_mode": "log",
    "timing": {
      "global_cycles": 1,
      "default_test_cycles": 1
    },
    "large_pages": true
  },
